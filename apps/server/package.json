{
  "name": "@mentro/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node24 --outDir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.1.0",
    "@mentro/protocol": "workspace:*",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "ulid": "^2.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
