# Compose interpolation template — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; this file is the committed documentation.

# Bind-mount seen by the container as /sources (the asset pool).
MENTRO_SOURCES_DIR=/absolute/path/to/your/asset/pool

# AI assistant (search-page card): any OpenAI-compatible endpoint.
# Leave empty to disable — the toggle then reports "not configured".
# Example (DeepSeek):  https://api.deepseek.com/v1  +  deepseek-chat
MENTRO_LLM_BASE_URL=
MENTRO_LLM_API_KEY=
MENTRO_LLM_MODEL=
